<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SleepDrives</RootNamespace>
    <AssemblyName>SleepDrives</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Enables System.Windows.Forms.NotifyIcon for the system tray. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\SleepDrives.ico</ApplicationIcon>
    <!-- Taking disks offline/online via MSFT_Disk requires elevation, so the
         app always runs as administrator. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>SleepDrives</AssemblyTitle>
    <Product>SleepDrives</Product>
    <Company>bdh-utils</Company>
    <Version>1.1.0</Version>
    <Copyright>© 2026 bdh-utils</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Storage management (MSFT_Disk) lives behind System.Management/WMI. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled with the app so the tray/window icon is available at runtime. -->
    <Resource Include="Resources\SleepDrives.ico" />
  </ItemGroup>

</Project>
