<Window x:Class="SleepDrives.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SleepDrives"
        mc:Ignorable="d"
        Title="SleepDrives" Height="680" Width="460"
        MinHeight="520" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrandBg}">
    <Window.Resources>
        <!-- Primary buttons -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource BrandSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Day-of-week toggle chips -->
        <Style x:Key="DayToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="chip" CornerRadius="15" Background="{StaticResource BrandBg}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource BrandAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HH:mm time entry -->
        <Style x:Key="TimeBox" TargetType="TextBox">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MaxLength" Value="5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Background" Value="{StaticResource BrandBg}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrandText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandMuted}"/>
        </Style>

        <!-- Section headers -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <!-- Drive row -->
        <DataTemplate x:Key="DriveRowTemplate" DataType="{x:Type local:DiskRowViewModel}">
            <Border Background="{StaticResource BrandSurface}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsManageable}"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrandText}"
                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource BrandMuted}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center"
                               Margin="8,0,0,0" Foreground="{StaticResource BrandMuted}"
                               FontSize="12" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Schedule window editor -->
        <DataTemplate x:Key="WindowRowTemplate" DataType="{x:Type local:ScheduleWindowViewModel}">
            <Border Background="{StaticResource BrandSurface}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource DayToggle}" Content="M" IsChecked="{Binding Monday, Mode=TwoWay}"/>
                        <ToggleButton Style="{StaticResource DayToggle}" Content="T" IsChecked="{Binding Tuesday, Mode=TwoWay}"/>
                        <ToggleButton Style="{StaticResource DayToggle}" Content="W" IsChecked="{Binding Wednesday, Mode=TwoWay}"/>
                        <ToggleButton Style="{StaticResource DayToggle}" Content="T" IsChecked="{Binding Thursday, Mode=TwoWay}"/>
                        <ToggleButton Style="{StaticResource DayToggle}" Content="F" IsChecked="{Binding Friday, Mode=TwoWay}"/>
                        <ToggleButton Style="{StaticResource DayToggle}" Content="S" IsChecked="{Binding Saturday, Mode=TwoWay}"/>
                        <ToggleButton Style="{StaticResource DayToggle}" Content="S" IsChecked="{Binding Sunday, Mode=TwoWay}"/>
                    </StackPanel>
                    <DockPanel Margin="0,12,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Disable from" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrandText}" FontSize="13"/>
                        <TextBox DockPanel.Dock="Left" Style="{StaticResource TimeBox}"
                                 Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock DockPanel.Dock="Left" Text="to" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrandText}" FontSize="13"/>
                        <TextBox DockPanel.Dock="Left" Style="{StaticResource TimeBox}"
                                 Text="{Binding EndText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <Button DockPanel.Dock="Right" Content="Remove" FontSize="12" Padding="10,6"
                                Background="{StaticResource BrandBg}" Click="RemoveWindow_Click"/>
                    </DockPanel>
                    <TextBlock Text="{Binding OvernightNote}" Foreground="{StaticResource BrandMuted}"
                               FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="&#x1F5C4;" FontSize="24" Foreground="{StaticResource BrandAccent}" VerticalAlignment="Center"/>
            <TextBlock Text="SleepDrives" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandText}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Status -->
        <Border Grid.Row="1" Background="{StaticResource BrandSurface}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="{StaticResource BrandMuted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Schedule is off" Foreground="{StaticResource BrandText}" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Master switch -->
        <StackPanel Grid.Row="2" Margin="2,0,0,12">
            <CheckBox x:Name="EnforceCheck" Content="Enforce this schedule automatically"
                      Foreground="{StaticResource BrandText}" FontSize="14" FontWeight="SemiBold"
                      Checked="EnforceCheck_Changed" Unchecked="EnforceCheck_Changed"/>
            <TextBlock Text="Disabling a drive forces its volumes to dismount — don't schedule a drive you may be reading or writing at the time."
                       Foreground="{StaticResource BrandMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Scrollable configuration -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- Drives -->
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionHeader}" Text="Drives to manage" Margin="2,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Hyperlink Foreground="{StaticResource BrandAccent}" TextDecorations="None"
                                   Click="RefreshLink_Click">Refresh</Hyperlink>
                    </TextBlock>
                </DockPanel>
                <ItemsControl x:Name="DrivesList" ItemTemplate="{StaticResource DriveRowTemplate}"/>
                <TextBlock x:Name="NoDrivesHint" Visibility="Collapsed"
                           Text="No manageable drives found — the Windows boot and system disks are always protected."
                           Foreground="{StaticResource BrandMuted}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,8"/>

                <!-- Schedule -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Disable during these times" Margin="2,14,0,8"/>
                <ItemsControl x:Name="WindowsList" ItemTemplate="{StaticResource WindowRowTemplate}"/>
                <TextBlock x:Name="NoWindowsHint" Visibility="Collapsed"
                           Text="No time windows yet — add one to schedule when the selected drives are disabled."
                           Foreground="{StaticResource BrandMuted}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,8"/>
                <Button x:Name="AddWindowButton" Content="+ Add time window" HorizontalAlignment="Left"
                        Background="{StaticResource BrandSurface}" Click="AddWindowButton_Click" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Options -->
        <StackPanel Grid.Row="4" Margin="2,14,0,0">
            <CheckBox x:Name="StartupCheck" Content="Run when I sign in to Windows"
                      Foreground="{StaticResource BrandText}" FontSize="13"
                      Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
            <CheckBox x:Name="StartMinimisedCheck" Content="Start minimised to the tray"
                      Foreground="{StaticResource BrandText}" FontSize="13" Margin="0,8,0,0"
                      Checked="StartMinimisedCheck_Changed" Unchecked="StartMinimisedCheck_Changed"/>
        </StackPanel>

        <!-- About link -->
        <TextBlock Grid.Row="5" Margin="0,14,0,0" HorizontalAlignment="Right">
            <Hyperlink Foreground="{StaticResource BrandAccent}" TextDecorations="None"
                       Click="AboutLink_Click">About</Hyperlink>
        </TextBlock>
    </Grid>
</Window>
